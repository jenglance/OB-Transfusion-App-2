# === Server ===
server <- function(input, output, session) {
  
  # --- Update indications choices dynamically ---
  observe({
    req(input$cesarean)
    choices <- indications_levels
    if (input$cesarean == "1") {
      choices <- setdiff(choices, "Vaginal")
    } else {
      if (!("Vaginal" %in% choices)) choices <- c("Vaginal", choices)
    }
    
    selected_val <- input$indications
    if (is.null(selected_val) || !(selected_val %in% choices) || input$cesarean == "0") {
      selected_val <- "Vaginal"
    }
    
    updateSelectInput(session, "indications", choices = choices, selected = selected_val)
  })
  
  # --- Clinician predictions ---
  observeEvent(input$predictBtn, {
    tryCatch({
      new_data <- data.frame(
        CesareanDelivery = as.numeric(input$cesarean),
        InductionUsed = as.numeric(input$induction),
        Cesarean.Indications = factor(input$indications, levels = indications_levels),
        id = 9999
      )
      
      new_data <- new_data[, names(xgb_model$trainingData)[names(xgb_model$trainingData) != ".outcome"]]
      pred_prob <- predict(xgb_model, newdata = new_data, type = "prob")
      prob_yes <- pred_prob[,"yes"]
      
      pred_class <- factor(ifelse(prob_yes >= input$threshold, "yes", "no"), levels = c("no","yes"))
      risk_band <- getRiskBand(prob_yes, input$threshold, buffer = input$buffer)
      
      output$predictionOutput <- renderPrint({
        cat("Predicted Class:", as.character(pred_class), "\n")
        cat("Probability of Requiring a Transfusion:", round(prob_yes, 4), "\n")
        cat("Risk Band:", risk_band, "\n")
        cat("Classification threshold used:", round(input$threshold, 4), "\n")
        cat("Moderate Risk buffer (±):", round(input$buffer, 4))
      })
    }, error = function(e) {
      output$predictionOutput <- renderPrint({cat("Error in prediction:\n", e$message)})
    })
  })
  
  # --- Feature importance plot ---
  output$importancePlot <- renderPlot({
    importance <- xgb.importance(model = xgb_model$finalModel) %>% filter(Feature != "id")
    ggplot(importance, aes(x = reorder(Feature, Gain), y = Gain)) +
      geom_bar(stat = "identity", fill = "pink") +
      coord_flip() +
      labs(title = "Feature Importance (by Gain)", x = "Feature", y = "Gain") +
      theme_minimal()
  })
  
  # --- ROC plot ---
  output$rocPlot <- renderPlot({
    if (!is.null(input$csvFile)) {
      df <- read.csv(input$csvFile$datapath)
      if ("churn" %in% colnames(df) && "Probability_Yes" %in% colnames(df)) {
        roc_obj <- pROC::roc(df$churn, df$Probability_Yes)
        plot.roc(roc_obj, col="darkblue", main="ROC Curve (Uploaded Data)", print.auc=TRUE)
      } else {
        plot.new(); text(0.5,0.5,"CSV must contain 'churn' and 'Probability_Yes'")
      }
    } else {
      plot.roc(roc_obj_train, col="darkblue", main="ROC Curve (Training CV Predictions)", print.auc=TRUE)
    }
  })
  
  # --- AUC text ---
  output$aucOutput <- renderPrint({
    if (!is.null(input$csvFile)) {
      df <- read.csv(input$csvFile$datapath)
      if ("churn" %in% colnames(df) && "Probability_Yes" %in% colnames(df)) {
        roc_obj <- pROC::roc(df$churn, df$Probability_Yes)
        cat("AUC (Uploaded Data):", round(pROC::auc(roc_obj),4))
      } else {
        cat("AUC: Cannot calculate (missing columns)")
      }
    } else {
      cat("AUC (Training CV):", round(pROC::auc(roc_obj_train),4))
    }
  })
  
  # --- Optional: uploaded predictions table ---
  output$uploadedPreds <- renderDT({
    req(input$csvFile)
    df <- read.csv(input$csvFile$datapath)
    if ("Probability_Yes" %in% colnames(df)) {
      datatable(df)
    }
  })
  
}

# === Run app ===
shinyApp(ui = ui, server = server)